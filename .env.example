PORT=5000
# Allowed CORS origin(s); '*' allows all (insecure for production)
ALLOWED_ORIGIN=*
# TURN server URLs (comma-separated); format: turn:host:3478,turns:host:5349
TURN_URLS=
# TURN secret; when set, generates short-lived credentials (username=unix timestamp,
# credential=base64(HMAC-SHA1(username, TURN_SECRET)), TTL=1 hour)
TURN_SECRET=
# Static TURN username (used if TURN_SECRET is not set)
TURN_USERNAME=
# Static TURN credential (used if TURN_SECRET is not set)
TURN_CREDENTIAL=